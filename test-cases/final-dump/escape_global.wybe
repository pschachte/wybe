# Test that the PTG interprocedural summary (ProcPTGSummary) records escape.
# `stash` stores its pointer-typed parameter `p` into a global resource, so the
# summary must classify parameter 0 as GlobalEscape.  The proc is recursive so
# it is not inlined, ensuring alias analysis actually runs over its body.

type point { pub point(x:int, y:int) }

resource saved:point = point(0, 0)

pub def stash(p:point, n:int) use !saved {
    ?saved = p
    if { n > 0 :: !stash(p, n - 1) }
}
