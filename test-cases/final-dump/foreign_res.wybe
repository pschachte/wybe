# Test case for access to foreign resources (C global variables)

resource foreign g_malloc_count : count128
resource foreign benchmark_in_progress : int32
# resource benchmark_in_progress : bool = false

pub def {test} now_benching use benchmark_in_progress {
    benchmark_in_progress ~= 0:int32
}

# resource foreign stdin : opaque_pointer

if { !now_benching :: !println("running benchmark")
   | else          :: !println("not currently benchmarking")
}

!println("benchmark_in_progress = $benchmark_in_progress")
# !println("stdin = $stdin")
