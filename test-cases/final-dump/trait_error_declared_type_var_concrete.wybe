# A declared type variable can't become a concrete type, whether or not it is
# declared with a trait bound.

type my_add trait {
    abstract plus(a:_, b:_):_
}

impl int <: my_add

def plus(a:int, b:int):int = a + b

def unbounded(i:I, ?j:I) { ?j = my_add.plus(i, 1) }

def declared_bound(i:I<:my_add, ?j:I) { ?j = my_add.plus(i, 1) }

def as_concrete(i:I<:my_add, ?j:int) { ?j = i }
