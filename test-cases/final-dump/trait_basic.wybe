# Verify trait dispatch and combined bounds across imported trait modules.

use trait_import_support.basic_speaker,
    trait_import_support.basic_named,
    trait_import_support.basic_dog

def speak_through_trait(x:trait_import_support.basic_speaker): string = speak(x)

def speak_and_describe(x:T<:{trait_import_support.basic_speaker,
                             trait_import_support.basic_named}): string = describe(x)

# The bound on y also constrains x because both use T.
def type_var_bound_union(x:T<:trait_import_support.basic_speaker,
                         y:T<:trait_import_support.basic_named): string = describe(x)

!println(speak_through_trait(trait_basic_dog("Rex")))
