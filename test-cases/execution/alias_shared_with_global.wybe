# BUG-8 (alias audit pass 2, see scratch/alias_analysis_bugs.md): a destructive
# update must not corrupt a live alias; correct output matches each "expect".
pub type position { pub position(x:int, y:int) }
pub type pair { pub pair(fst:position, snd:int) }
pub def pp(pos:position) use !io { !print(" ("); !print(pos^x); !print(","); !print(pos^y); !println(")") }
resource stash:position = position(0,0)
pub def {noinline} bump(p:pair, ?b:position) { ?b = p^fst; x(!b, 999) }
pub def {noinline} show() use !io, stash { !print("expect stash (1,2):"); !pp(stash) }
# leaf is reachable from the resource AND from pr (but no variable names it):
# pr must not count as deeply unaliased.
!read(?i:int)
?leaf = position(i, 2)
?stash = leaf
?pr = pair(leaf, 0)
bump(pr, ?r)
!print("expect r (999,2):"); !pp(r)
!show
