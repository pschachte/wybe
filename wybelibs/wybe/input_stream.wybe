# purpose: Standard posix buffered input stream
# since  : 0.2

# Note:  this type is not marked unique, but updates to this structure are
# forced to be destructive.  To make this valid, it's essential that operations
# that mutate this structure are declared to `use !io_state`.  Operations that
# access this structure *should* be declared to `use io_state`, so they are only
# allowed where `io_state` is available, but currently Wybe's uniqueness system
# does not allow unique values or resources to be passed as input-only, and
# making operations that access parts of an input_stream `use !io_state` would be
# annoying and also misleading, since they don't modify it.

representation is address

# XXX The uniqueness of `io_state` causes difficulty, because it stops us from
# using failure and backtracking to undo reading by pushing back input.
# Instead, we provide an explicit `pushback` operation, which "undoes" the
# reading of one character.  Only one character of pushback is supported, so
# pushback is only allowed when the previous operation on the stream was a read.
#
# We also support a `peek` operation, which produces the next character from the
# input stream without consuming it, so the next read operation will provide the
# same character again.
#
# Since only one character of pushback is supported, and only when the previous
# operation was a read, pushback is handled by simply moving the next character
# pointer backwards, after checking that the buffer is not empty.  This works
# because we only read the next bufferful when its first character is to be
# returned by read or peek.


# The size of an input buffer.
pub def input_buffer_size : int = 8*1024 # fixed buffer size in bytes


# Layout of input_stream:
# offset  byte size  field          contents
#    0       8       next_pointer   pointer to next byte of current buffer
#    8       8       end_pointer    pointer to end of current buffer
#   16       8       fd             POSIX file descriptor
#   24       8K      buffer         actual buffer bytes

def ptr_size : int         = foreign lpvm sizeof(_:address)
def fd_size  : int         = foreign lpvm sizeof(_:int)
def raw_data_offset : int  = 2*ptr_size + fd_size
def input_stream_size:int  = raw_data_offset + input_buffer_size
def address(buf:_):address = foreign lpvm cast(buf)
def buffer(buf:_):address  = buf^address + raw_data_offset

# Accessors and mutators for input_stream type.

# XXX These are manually generated because Wybe does not support inlining of
# structure members.

def {inline} next_pointer(buf:_):address =
    foreign lpvm cast(foreign lpvm access(buf, 0, input_stream_size, 0))
def {inline} next_pointer(!buf:_, start_ptr:address) use !io_state {
    foreign lpvm mutate(buf, ?buf, 0, 1, input_stream_size, 0, start_ptr)
}
def {inline} end_pointer(buf:_):address = # actually, one byte past the end
    foreign lpvm access(buf, ptr_size, input_stream_size, 0)
def {inline} end_pointer(!buf:_, end_ptr:address) use !io_state {
    foreign lpvm mutate(buf, ?buf, ptr_size, 1, input_stream_size, 0, end_ptr)
}
def {inline} fd(buf:_):int =
    foreign lpvm access(buf, ptr_size*2, input_stream_size, 0)
def {inline} fd(!buf:_, fd:int) use !io_state {
    foreign lpvm mutate(buf, ?buf, ptr_size*2, 1, input_stream_size, 0, fd)
}

# Construct an input buffer for the specified fd
pub def input_buffer(fd:int, ?buf:_) use !io_state {
    foreign lpvm alloc(input_stream_size, ?buf:_)
    ?start_ptr = buffer(buf)
    !next_pointer(!buf, start_ptr)
    !end_pointer(!buf, start_ptr) # buffer starts empty
    !fd(!buf, fd)
}

# Peek at the next character in an input stream.  This does not change the
# notional state of the stream, so repeating this operation will produce the
# same result.
# XXX This should be a test, failing on EOF, but we currently can't have a
# test that uses !io_state, because it's unique.
pub def peek(?ch:char, !buf:_) use !io_state {
    if {  buf^end_pointer <= buf^next_pointer ::
        !read_buffer(foreign lpvm cast(buf^fd):int32,
                        buf^buffer, input_buffer_size, ?bytes_read)
        # bytes_read ~= 0 # XXX should fail on EOF
        if { bytes_read > 0 ::
            !next_pointer(!buf, buf^buffer)
            !end_pointer(!buf, buf^buffer + bytes_read)
            foreign lpvm access(buf^next_pointer, 0, 1, 0, ?ch:char)
        | bytes_read = 0 ::
            ?ch = eof
        | else ::
            !error("Read error $bytes_read")
        }
    | else ::
        foreign lpvm access(buf^next_pointer, 0, 1, 0, ?ch:char)
    }
}

pub def peek(?ch:char) use current_in, !io_state { !peek(?ch, current_in) }


# Read a single character from an input_stream.
# XXX This should be a test, but we currently can't have a test
# that uses !io_state, because it's unique.
pub def {inline} read(?ch:char, !buf:_) use !io_state {
    !peek(?ch, !buf)
    if { ch ~= eof :: !next_pointer(!buf, buf^next_pointer + 1) }
}

pub def read(?ch:char) use current_in, !io_state { !read(?ch, current_in) }


# Push back a single character in an input_stream.  The stream itself remembers
# the character to be pushed back.  Reports an error if the last operation on
# this stream wasn't a read.
pub def pushback(!buf:_) use !io_state {
    if { buf^next_pointer <= buf^buffer ::
            !error("pushback not following read")
    }
    !next_pointer(!buf, buf^next_pointer - 1)
}

pub def pushback use current_in, !io_state { !pushback(current_in) }


# The end-of-file character.
# XXX This shouldn't exist; instead, reading should fail on end-of-file.
pub def {inline} eof:char = foreign lpvm cast(-1)



## Interface to POSIX IO primitives
# XXX int32 is the size of a C int on this architecture.  We should have a Wybe
# type or type synonym that specifies C's int type (and other C types).
def foreign c read_buffer =
    read(fd:int32, buffer:address, size:int, ?bytes_read:int) use !io_state
