# purpose: Standard IO Library
# since  : 0.1

pragma no_standard_library  # Standard library can't depend on itself!

use foreign object cbits
use foreign library gc

pub use wybe.phantom
use wybe.char, wybe.address, wybe.int, wybe.int32

# XXX We shouldn't need to initialise a resource (or variable) of a 0-bit type
pub resource io:phantom = phantom
# pub resource io_state:phantom = phantom

pub resource stdin :io_stream = !input_buffer(0)
pub resource stdout:io_stream = !input_buffer(1)
pub resource stderr:io_stream = !input_buffer(2)

# pub resource io = io_state, stdin, stdout, stderr

# XXX This module depends on wybe.char, and as such inline marking is delayed
# before other modules
pub def {inline} nl use !io { foreign c putchar('\n', !io) }

# XXX see nl for inline note
pub def {inline} eof:char = foreign lpvm cast(-1)


pub def buffer_size : int = 8*1024 # fixed buffer size in bytes


# XXX int32 is the size of a C int on this architecture
def foreign c read_buffer =
    read(fd:int32, buffer:address, size:int, ?bytes_read:int) use !io
def foreign c write_buffer =
    write(fd:int32, buffer:address, size:int, ?bytes_written:int) use !io

# Note:  this type is not marked unique, but updates to this is structure are
# forced to be destructive.  To make this valid, it's essential that operations
# that mutate this structure are declared to `use !io`.  Operations that access
# this structure *should* be declared to `use io`, so they are only allowed
# where `io` is available, but currently Wybe's uniqueness system does not allow
# unique values or resources to be passed as input-only, and making operations
# that access parts of an io_stream `use !io` would be annoying and also
# misleading, since they don't modify it.
pub type io_stream is address {
    # Layout of io_stream:
    # offset  byte size  contents
    #    0       8       pointer to next byte to read/write
    #    8       8       pointer to first byte beyond readable/writeable memory
    #   16       8       POSIX file descriptor
    #   24  buffer_size  actual buffer bytes

    def ptr_size : int = foreign lpvm sizeof(_:address)
    def fd_size  : int = foreign lpvm sizeof(_:int)
    def raw_data_offset : int = 2*ptr_size + fd_size
    def io_buffer_size : int = buffer_size + raw_data_offset
    def address(buf:_):address = foreign lpvm cast(buf)
    def buffer_end(buf:_):address = buf^address + io_buffer_size
    def start_pointer(buf:_):address = buf^address + raw_data_offset

    def {inline} next_pointer(buf:_):address =
        foreign lpvm cast(foreign lpvm access(buf, 0, io_buffer_size, 0))

    def {inline} next_pointer(!buf:_, start_ptr:address) use !io {
        foreign lpvm mutate(buf, ?buf, 0, 1, io_buffer_size, 0, start_ptr)
    }

    def {inline} end_pointer(buf:_):address = # actually, one byte past the end
        foreign lpvm access(buf, ptr_size, io_buffer_size, 0)

    def {inline} end_pointer(!buf:_, end_ptr:address) use !io {
        foreign lpvm mutate(buf, ?buf, ptr_size, 1, io_buffer_size, 0, end_ptr)
    }

    def {inline} fd(buf:_):int =
        foreign lpvm access(buf, ptr_size*2, io_buffer_size, 0)

    def {inline} fd(!buf:_, fd:int) use !io {
        foreign lpvm mutate(buf, ?buf, ptr_size*2, 1, io_buffer_size, 0, fd)
    }

    pub def input_buffer(fd:int, ?buf:_) use !io {
        foreign lpvm alloc(io_buffer_size, ?buf:_)
        ?start_ptr = start_pointer(buf)
        !next_pointer(!buf, start_ptr)
        !end_pointer(!buf, start_ptr) # buffer starts empty
        !fd(!buf, fd)
    }

    pub def output_buffer(fd:int, ?buf:_) use !io {
        foreign lpvm alloc(io_buffer_size, ?buf:_)
        ?start_ptr = start_pointer(buf)
        !next_pointer(!buf, start_ptr)
        !fd(!buf, fd)
    }

    # This should be a test, but we currently can't have a test
    # that uses !io, because it's unique.
    pub def read(!buf:_, ?ch:char) use !io {
        if {  buf^end_pointer <= buf^next_pointer ::
            !read_buffer(foreign lpvm cast(buf^fd):int32,
                         buf^start_pointer, buffer_size, ?bytes_read)
            # bytes_read ~= 0 # XXX should fail on EOF
            if { bytes_read > 0 ::
                !next_pointer(!buf, buf^start_pointer)
                !end_pointer(!buf, buf^start_pointer + bytes_read)
                foreign lpvm access(buf^next_pointer, 0, 1, 0, ?ch:char)
                !next_pointer(!buf, buf^next_pointer + 1)
            | bytes_read = 0 ::
                ?ch = eof
            | else ::
                !error("Read error")
             }
        | else ::
            foreign lpvm access(buf^next_pointer, 0, 1, 0, ?ch:char)
            !next_pointer(!buf, buf^next_pointer + 1)
        }
    }

    # We assume there is space in the buffer for at least one character.
    pub def print(!buf:_, ch:char) use !io {
        ?ptr = buf^next_pointer
        foreign lpvm mutate(ptr, ?ptr, 0, 1, io_buffer_size, 0, ch)
        !next_pointer(!buf, ptr + 1)
        if {  buf^next_pointer > buf^buffer_end :: !flush_output(!buf) }
    }

    pub def print(!buf:_, str:string) use !io {
        # !map(print(!buf), str)
        for ?ch in str { !print(!buf, ch) }
    }

    pub def println(!buf:_, str:string) use !io {
        !print(!buf, str)
        !print(!buf, '\n')
    }

    pub def flush_output(!buf:_) use !io {
        ?byte_count = buf^next_pointer - buf^start_pointer
        if { byte_count > 0 ::
            !write_buffer(foreign lpvm cast(buf^fd):int32,
                            buf^start_pointer, byte_count, ?bytes_written)
            if { bytes_written ~= byte_count :: !error("Write error") }
            !next_pointer(!buf, buf^start_pointer)
        }
    }
}

!input_buffer(0, ?stdin)
!output_buffer(1, ?stdout)
!output_buffer(2, ?stderr)

