# purpose: Standard IO Library
# since  : 0.1

pragma no_standard_library  # Standard library can't depend on itself!

use foreign object cbits
use foreign library gc

pub use wybe.phantom
use wybe.char, wybe.address, wybe.int, wybe.int32, wybe.bool
use wybe.input_stream, wybe.output_stream, wybe.source, wybe.sink
use wybe.printable

pub resource io = io_state, stdin, stdout, stderr,
                    current_in, current_out, current_err

# XXX We shouldn't need to initialise a resource (or variable) of a 0-bit type
pub resource io_state:phantom = phantom

pub resource stdin :input_stream = !input_buffer(0)
pub resource stdout:output_stream = !output_buffer(1)
pub resource stderr:output_stream = !output_buffer(2)

pub resource current_in :input_stream = stdin
pub resource current_out:output_stream = stdout
pub resource current_err:output_stream = stderr

## Printing

# Print a printable thing to the current output stream
pub def print(datum:printable) use !io { !print(datum, current_out) }

# Print a printable thing to the current output stream, follwed by a newline
pub def println(datum:printable, sink:sink) use !io_state {
    !print(datum, sink)
    !nl(sink)
}

pub def println(datum:printable) use !io { !println(datum, current_out) }

pub def nl(buf:sink) use !io_state { !write('\n', !buf) }
pub def nl use current_out, !io_state { !nl(current_out) }
